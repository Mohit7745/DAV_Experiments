import pandas as pd
from statsmodels.stats.weightstats import ztest

# 1. Load the dataset directly from a raw URL (No upload needed!)
url = "https://raw.githubusercontent.com/npradaschnor/Pima-Indians-Diabetes-Dataset/master/diabetes.csv"
uci_diabetes = pd.read_csv(url)

# 2. Clean the specific column by dropping any missing values (NaNs)
glucose_data = uci_diabetes["Glucose"].dropna()

# 3. Perform Z-Test for Glucose (Testing if mean Glucose differs from 100)
z_stat, p_value = ztest(glucose_data, value=100)

# 4. Display Results
print("-" * 30)
print(f"Z-Statistic: {z_stat:.4f}")
print(f"P-Value: {p_value:.4f}")
print("-" * 30)

# 5. Interpretation
alpha = 0.05 # 5% significance level
if p_value < alpha:
  print("Reject the null hypothesis: The mean Glucose level is significantly different from 100.")
else:
  print("Fail to reject the null hypothesis: No significant difference in mean Glucose level.")
